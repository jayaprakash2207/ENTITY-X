# ── AI / LLM Keys ─────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from https://console.groq.com/keys  (free, no credit card)
GROQ_API_KEY=your_groq_api_key_here

# Get from https://openrouter.ai/keys  (free tier available)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Legacy alias for OPENROUTER_API_KEY — set either one
# DEEPSEEK_API_KEY=your_deepseek_key_here

# Get from https://huggingface.co/settings/tokens  (free with HF account)
# Falls back to anonymous/rate-limited access if not set
HF_API_KEY=your_hf_token_here

# ── Backend API URLs ───────────────────────────────────────────────────────────
# Defaults shown — only set these if running the backend on a different host/port
# IMAGE_MONITOR_API_URL=http://127.0.0.1:8000/api/image-monitor
# TEXT_MONITOR_API_URL=http://127.0.0.1:8000/api/text-monitor
# NEWS_SCANNER_API_URL=http://127.0.0.1:8000/api/news-scanner
# LEGAL_CHAT_API_URL=http://127.0.0.1:8000/api/legal/chat

# ── Backend Config ─────────────────────────────────────────────────────────────
# Port the FastAPI backend listens on (default: 8000)
BACKEND_PORT=8000

# ── yt-dlp / Video & Audio Download ───────────────────────────────────────────
# Required only for downloading age-restricted or login-gated YouTube content.
# Option 1 — path to a Netscape cookies file exported from your browser:
# ENTITYX_YTDLP_COOKIES_PATH=/path/to/cookies.txt
# Option 2 — let yt-dlp pull cookies directly from your browser (chrome/firefox/edge):
# ENTITYX_YTDLP_COOKIES_BROWSER=chrome

# ── AI Model Flags ─────────────────────────────────────────────────────────────
# Set to 1 to skip the Universal Fake Detector (UFD) model — speeds up image
# analysis when the .pth weights file is unavailable or slow to load
# SKIP_UFD=1

# ── Electron ──────────────────────────────────────────────────────────────────
# Set to "development" to enable DevTools and verbose logging
NODE_ENV=production

# Uncomment to force DevTools open even in production
# DEBUG_ELECTRON=1
